; Engine configuration file.
; Edit through the Godot editor when possible.

config_version=5

[application]

config/name="Aegis of Ember"
config/description="A lightweight offline castle defense game for Windows."
config/version="0.1.0-mvp"
run/main_scene="res://scenes/bootstrap.tscn"

[autoload]

GameApp="*res://src/autoload/game_app.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

common/physics_ticks_per_second=30

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.018, 0.027, 0.047, 1)

[input]

combat_aim={
"deadzone": 0.5,
"events": []
}
combat_fire={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"button_index":1)]
}
combat_cast={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"button_index":1)]
}
combat_select_fire={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":49)]
}
combat_select_ice={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":50)]
}
combat_select_lightning={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":51)]
}
combat_cancel_cast={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"button_index":2)]
}
game_pause={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}
